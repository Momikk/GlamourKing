<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DalamudHome Condition="'$(DalamudHome)' == ''">$(APPDATA)/XIVLauncherCN/addon/Hooks/dev</DalamudHome>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SuitKing/OutfitStorageState.cs" Link="OutfitStorageState.cs" />
    <Compile Include="../SuitKing/NativeNameHighlightPolicy.cs" Link="NativeNameHighlightPolicy.cs" />
    <Compile Include="../SuitKing/EquipmentParts.cs" Link="EquipmentParts.cs" />
    <Compile Include="../SuitKing/OutfitEquipment.cs" Link="OutfitEquipment.cs" />
    <Compile Include="../SuitKing/OutfitCatalog.cs" Link="OutfitCatalog.cs" />
    <Reference Include="Lumina"><HintPath>$(DalamudHome)/Lumina.dll</HintPath></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudHome)/Lumina.Excel.dll</HintPath></Reference>
  </ItemGroup>
</Project>
